# Optional: the project id and dataset default to the ones in sanity/env.js
# NEXT_PUBLIC_SANITY_PROJECT_ID=bgu6nodr
# NEXT_PUBLIC_SANITY_DATASET=production

# Read token, used server-side only. Needed only if the dataset is private.
# REACT_APP_SANITY_TOKEN is also accepted (the name already set on Netlify).
SANITY_API_READ_TOKEN=YOUR_TOKEN_WITHOUT_QUOTES
